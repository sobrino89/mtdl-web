                  {
                    "type": "string"
                  },
                  {
                    "type": "null"
                  }
                ],
                "default": null,
                "title": "Folder"
              },
              "season": {
                "anyOf": [
                  {
                    "maximum": 9999,
                    "minimum": 0,
                    "type": "integer"
                  },
                  {
                    "type": "null"
                  }
                ],
                "default": null,
                "title": "Season"
              },
              "template": {
                "anyOf": [
                  {
                    "type": "string"
                  },
                  {
                    "type": "null"
                  }
                ],
                "default": null,
                "title": "Template"
              },
              "target": {
                "default": "downloads",
                "enum": [
                  "downloads",
                  "library"
                ],
                "title": "Target",
                "type": "string"
              },
              "tmdb_id": {
                "anyOf": [
                  {
                    "minimum": 1,
                    "type": "integer"
                  },
                  {
                    "type": "null"
                  }
                ],
                "default": null,
                "title": "Tmdb Id"
              },
              "library_id": {
                "anyOf": [
                  {
                    "minimum": 1,
                    "type": "integer"
                  },
                  {
                    "type": "null"
                  }
                ],
                "default": null,
                "title": "Library Id"
              }
            },
            "title": "NamingIn",
            "type": "object"
          },
          "SubscriptionChanges": {
            "additionalProperties": false,
            "description": "What to change in a saved subscription; fields left out stay as they are.",
            "properties": {
              "name": {
                "anyOf": [
                  {
                    "type": "string"
                  },
                  {
                    "type": "null"
                  }
                ],
                "default": null,
                "title": "Name"
              },
              "query": {
                "anyOf": [
                  {
                    "type": "string"
                  },
                  {
                    "type": "null"
                  }
                ],
                "default": null,
                "title": "Query"
              },
              "include_description": {
                "anyOf": [
                  {
                    "type": "boolean"
                  },
                  {
                    "type": "null"
                  }
                ],
                "default": null,
                "title": "Include Description"
              },
              "source": {
                "anyOf": [
                  {
                    "enum": [
                      "filmlist",
                      "mediathekviewweb"
                    ],
                    "type": "string"
                  },
                  {
                    "type": "null"
                  }
                ],
                "default": null,
                "title": "Source"
              },
              "conditions": {
                "anyOf": [
                  {
                    "items": {
                      "$ref": "#/$defs/ConditionIO"
                    },
                    "type": "array"
                  },
                  {
                    "type": "null"
                  }
                ],
                "default": null,
                "description": "Replaces all conditions.",
                "title": "Conditions"
              },
              "naming": {
                "anyOf": [
                  {
                    "$ref": "#/$defs/NamingIn"
                  },
                  {
                    "type": "null"
                  }
                ],
                "default": null
              },
              "quality": {
                "anyOf": [
                  {
                    "enum": [
                      "hd",
                      "normal",
                      "low"
                    ],
                    "type": "string"
                  },
                  {
                    "type": "null"
                  }
                ],
                "default": null,
                "description": "null: as in the settings.",
                "title": "Quality"
              },
              "subtitles": {
                "anyOf": [
                  {
                    "type": "boolean"
                  },
                  {
                    "type": "null"
                  }
                ],
                "default": null,
                "description": "null: as in the settings.",
                "title": "Subtitles"
              },
              "state": {
                "anyOf": [
                  {
                    "enum": [
                      "active",
                      "paused"
                    ],
                    "type": "string"
                  },
                  {
                    "type": "null"
                  }
                ],
                "default": null,
                "title": "State"
              },
              "valid_until": {
                "anyOf": [
                  {
                    "format": "date",
                    "type": "string"
                  },
                  {
                    "type": "null"
                  }
                ],
                "default": null,
                "description": "The last day; null removes it.",
                "title": "Valid Until"
              },
              "on_expiry": {
                "anyOf": [
                  {
                    "enum": [
                      "pause",
                      "delete"
                    ],
                    "type": "string"
                  },
                  {
                    "type": "null"
                  }
                ],
                "default": null,
                "title": "On Expiry"
              },
              "special_versions": {
                "anyOf": [
                  {
                    "enum": [
                      "setting",
                      "exclude",
                      "include"
                    ],
                    "type": "string"
                  },
                  {
                    "type": "null"
                  }
                ],
                "default": null,
                "title": "Special Versions"
              }
            },
            "title": "SubscriptionChanges",
            "type": "object"
          }
        },
        "properties": {
          "subscription_id": {
            "title": "Subscription Id",
            "type": "integer"
          },
          "changes": {
            "$ref": "#/$defs/SubscriptionChanges"
          }
        },
        "required": [
          "subscription_id",
          "changes"
        ],
        "title": "update_subscriptionArguments",
        "type": "object"
      }
    },
    {
      "name": "check_subscription",
      "write": true,
      "description": "Check a subscription now instead of after the next film list update; queues what it finds and lists\nwhat of the subscription waits or loads now.",
      "input_schema": {
        "properties": {
          "subscription_id": {
            "title": "Subscription Id",
            "type": "integer"
          }
        },
        "required": [
          "subscription_id"
        ],
        "title": "check_subscriptionArguments",
        "type": "object"
      }
    },
    {
      "name": "requeue_subscription",
      "write": true,
      "description": "Load a subscription's cancelled and failed episodes again: they leave the history and are queued\nanew with the subscription's naming and quality of today. Episodes loaded fine stay as they are.",
      "input_schema": {
        "properties": {
          "subscription_id": {
            "title": "Subscription Id",
            "type": "integer"
          }
        },
        "required": [
          "subscription_id"
        ],
        "title": "requeue_subscriptionArguments",
        "type": "object"
      }
    },
    {
      "name": "cancel_downloads",
      "write": true,
      "description": "Stop downloads that wait or load: the ones named by id, a subscription's, or with everything true\nall of them. Partial files are removed; the history keeps them as cancelled (requeue_subscription or\nenqueue_download with force load them again). Pausing a subscription does not stop its downloads.",
      "input_schema": {
        "properties": {
          "download_ids": {
            "anyOf": [
              {
                "items": {
                  "type": "integer"
                },
                "type": "array"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "title": "Download Ids"
          },
          "subscription_id": {
            "anyOf": [
              {
                "type": "integer"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "title": "Subscription Id"
          },
          "everything": {
            "default": false,
            "description": "Cancel all that waits or loads.",
            "title": "Everything",
            "type": "boolean"
          }
        },
        "title": "cancel_downloadsArguments",
        "type": "object"
      }
    },
    {
      "name": "update_settings",
      "write": true,
      "description": "Change the bandwidth limit (Mbit/s, for all downloads together, live), the preferred quality,\nsubtitles or how many downloads run at once. A limit schedule from the settings page may set another\nlimit at times; get_status shows the one in effect.",
      "input_schema": {
        "$defs": {
          "SettingsChanges": {
            "additionalProperties": false,
            "description": "Settings to change; fields left out stay as they are.",
            "properties": {
              "bandwidth_limit_mbit": {
                "anyOf": [
                  {
                    "minimum": 0,
                    "type": "number"
                  },
                  {
                    "type": "null"
                  }
                ],
                "default": null,
                "description": "Limit for all downloads together in Mbit/s; 0 = unlimited.",
                "title": "Bandwidth Limit Mbit"
              },
              "bandwidth_enabled": {
                "anyOf": [
                  {
                    "type": "boolean"
                  },
                  {
                    "type": "null"
                  }
                ],
                "default": null,
                "description": "Switch the limit on or off; the value stays.",
                "title": "Bandwidth Enabled"
              },
              "quality": {
                "anyOf": [
                  {
                    "enum": [
                      "hd",
                      "normal",
                      "low"
                    ],
                    "type": "string"
                  },
                  {
                    "type": "null"
                  }
                ],
                "default": null,
                "description": "Preferred quality; a film without it loads the next lower one.",
                "title": "Quality"
              },
              "subtitles": {
                "anyOf": [
                  {
                    "type": "boolean"
                  },
                  {
                    "type": "null"
                  }
                ],
                "default": null,
                "title": "Subtitles"
              },
              "parallel_downloads": {
                "anyOf": [
                  {
                    "maximum": 10,
                    "minimum": 1,
                    "type": "integer"
                  },
                  {
                    "type": "null"
                  }
                ],
                "default": null,
                "title": "Parallel Downloads"
              }
            },
            "title": "SettingsChanges",
            "type": "object"
          }
        },
        "properties": {
          "changes": {
            "$ref": "#/$defs/SettingsChanges"
          }
        },
        "required": [
          "changes"
        ],
        "title": "update_settingsArguments",
        "type": "object"
      }
    },
    {
      "name": "enqueue_download",
      "write": true,
      "description": "Queue one film (an id from search) into the download folder, named after the settings. Quality and\nsubtitles default to the settings.",
      "input_schema": {
        "properties": {
          "film_id": {
            "description": "A film id from search.",
            "pattern": "^\\d{1,20}$",
            "title": "Film Id",
            "type": "string"
          },
          "quality": {
            "anyOf": [
              {
                "enum": [
                  "hd",
                  "normal",
                  "low"
                ],
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "title": "Quality"
          },
          "subtitles": {
            "anyOf": [
              {
                "type": "boolean"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "title": "Subtitles"
          },
          "force": {
            "default": false,
            "description": "Load even if the broadcast was loaded before.",
            "title": "Force",
            "type": "boolean"
          }
        },
        "required": [
          "film_id"
        ],
        "title": "enqueue_downloadArguments",
        "type": "object"
      }
    }
  ]
}
