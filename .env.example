# mtdl-web: weitere Einstellungen über die Umgebung. Nach .env kopieren (cp .env.example .env), die gewünschten
# Zeilen einschalten (# am Anfang entfernen) und den Container neu erstellen: docker compose up -d
# PUID, PGID, UMASK und TZ stehen in der Compose-Datei; alles andere stellst du in der Oberfläche ein.
# Kommentare hinter einem Wert versteht Docker Compose; docker run --env-file nähme sie in den Wert mit.
# Erklärungen: https://sobrino89.github.io/mtdl-web/install/environment/

# Anmeldung
# MTDL_AUTH=password              # password, local, proxy oder none
# MTDL_PASSWORD=""                # Passwort fest vorgeben; sonst wählst du es beim ersten Aufruf
# MTDL_PASSWORD_FILE=""           # Passwort aus einer Datei, etwa einem Docker-Secret
# MTDL_PASSWORD_RESET=false       # true: Passwort beim nächsten Start einmal vergessen, neuer Code im Log
# MTDL_AUTH_HEADER=Remote-User    # nur bei proxy: Kopfzeile mit dem angemeldeten Benutzer
# MTDL_TRUSTED_PROXIES=""         # nur bei proxy, dort Pflicht: Adressen oder Netze der Proxys, mit Komma getrennt

# Integrationen
# MTDL_TMDB_TOKEN=""              # TMDB-Lesezugriffstoken für Bibliotheken; sonst in der Oberfläche eintragen
# MTDL_PLEX_TOKEN=""              # Plex-Token für das Neu-Einlesen; sonst in der Oberfläche, oft auch ganz ohne

# Betrieb
# MTDL_WORKERS=""                 # Prozesse für Import und ffmpeg; leer: alle Kerne
# MTDL_INDEX_DESCRIPTION=true     # false: Beschreibungen nicht durchsuchbar, spart gut 100 MB
# MTDL_LOG_LEVEL=info             # debug, info, warning oder error
# MTDL_HOOK_TIMEOUT=600           # Sekunden, die ein Skript nach einem Ereignis laufen darf
# MTDL_CHECK_MOUNTS=true          # false: auch in nicht eingebundene Ordner schreiben (nur im Ausnahmefall)

# Pfade und Port im Container
# MTDL_CONFIG_DIR=/config         # Zustand, Skripte und Cache
# MTDL_CACHE_DIR=/config/cache    # Filmliste und Suchindex, rund 1 GB, lässt sich jederzeit neu laden
# MTDL_DOWNLOAD_DIR=/downloads    # Download-Ordner
# MTDL_PORT=8080                  # Port im Container; nur bei geteiltem Netz (VPN-Container, host) ändern

# Abkürzung
# MTDL_SHOWS_DIR=""               # legt beim Start einmalig die Serienbibliothek „Serien“ aus diesem Ordner an
